# naia-memory — environment variables (example)
#
# Copy to `.env` and fill in. The shipped package (LocalAdapter / MemorySystem)
# needs NONE of these — they all have sane defaults. These are for running the
# optional HTTP server, choosing an embedding backend, tuning search, or running
# the benchmark harness. Never commit a real `.env` (it is gitignored).

# ── HTTP server (src/server/naia-memory-api.ts) ──────────────────────────────
PORT=9876
ADAPTER=local                       # local | sqlite
STORE_PATH=/tmp/locomo-naia-memory.json
VECTOR_STORE_PATH=                  # defaults next to STORE_PATH if unset

# ── Embedding model (local, in-process — no network/key needed) ──────────────
EMBED_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
EMBED_DIM=384

# ── Optional remote embedding gateway (leave blank to use the local model) ───
# If you front embeddings with your own OpenAI-compatible gateway, point here.
GATEWAY_URL=                        # e.g. https://<your-gateway-host>
GATEWAY_EMBED_URL=                  # embedding endpoint, if separate from GATEWAY_URL
GATEWAY_MASTER_KEY=                 # <REDACTED> — gateway auth key, if your gateway requires one

# ── Search tuning (src/memory/adapters/local.ts) ─────────────────────────────
NAIA_SEARCH_MODE=                   # override hybrid search mode (default: hybrid)
NAIA_MMR=                           # set to enable MMR re-ranking
NAIA_FILTER_DEBUG=                  # 1 = verbose contradiction-filter logging

# ── Benchmark harness only (src/benchmark/**) ────────────────────────────────
# Dataset path: download AI Hub 141 yourself; point here (else ~/data/aihub/...).
AIHUB_141_PATH=
# OpenAI-compatible vLLM endpoints used by comparison adapters
VLLM_BASE=
VLLM_EMBED_BASE=
VLLM_EMBED_MODEL=
VLLM_EMBED_DIM=
VLLM_REASONING_BASE=
VLLM_REASONING_MODEL=
# Third-party memory baselines compared against (each needs that vendor's key)
GEMINI_API_KEY=                     # <REDACTED>
GLM_API_KEY=                        # <REDACTED>
UPSTAGE_KEY=                        # <REDACTED>
MEM0_LLM_API_KEY=                   # <REDACTED>
MEM0_LLM_BASE_URL=
MEM0_LLM_MODEL=
MEM0_USER_ID=
MEM0_COLLECTION=
GRAPHITI_BASE=
# OpenClaw adapter overrides (default: ~/.naia/openclaw + ~/.openclaw/workspace)
OPENCLAW_BIN=
OPENCLAW_WORKSPACE=
